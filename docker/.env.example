# memchentic — copy to .env for local Compose
# Run from this directory: `cd docker && docker compose up -d --build`
# Do not commit .env (gitignored).

# ------------------------------------------------------------------------------
# compose
# ------------------------------------------------------------------------------
# Merge order: prod base, then local bind mounts.
# For a prod-shaped bring-up (no source mounts), use:
#   COMPOSE_FILE=docker-compose.yaml
COMPOSE_FILE=docker-compose.yaml:local.yaml

# ------------------------------------------------------------------------------
# application
# ------------------------------------------------------------------------------
# One container listener (:8080) path-routes GUI /, API /api, MCP /mcp.
# These host ports all publish that same listener — use distinct values
# (Compose cannot bind the same host port twice). BASE_URL is the public face
# (usually the GUI publish).
GUI_PORT=18080
API_PORT=18081
MCP_PORT=18082
BASE_URL=http://your-host:18080

# ------------------------------------------------------------------------------
# oauth
# ------------------------------------------------------------------------------
# google | github | okta | authentik | keycloak | auth0 | entra | gitlab | generic | internal
OAUTH_PROVIDER=internal
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_ISSUER=
OAUTH_AUDIENCE=
OAUTH_JWKS_URI=
OAUTH_SCOPES=openid,profile,email

# ------------------------------------------------------------------------------
# admin
# ------------------------------------------------------------------------------
# Break-glass admin for React UI / ops (bootstrap).
# Email is the login identity (same shape as ordinary users).
# DISPLAY_NAME is a label only — not accepted as a login alias.
ADMIN_EMAIL=admin@example.com
ADMIN_DISPLAY_NAME=Admin
ADMIN_PASSWORD=change-me
# Same principal as admin, for MCP/API without the UI login
ADMIN_API_KEY=change-me-admin-api-key
# Per-user API keys live in the DB (issued in UI).

# ------------------------------------------------------------------------------
# database
# ------------------------------------------------------------------------------
# Local Compose service name is `postgres`. Point POSTGRES_HOSTNAME at a remote
# host to use an external Postgres (pgvector required). Changing user/password/db
# after first boot does not rewrite an existing local volume.
POSTGRES_USER=memchentic
POSTGRES_PASSWORD=memchentic
POSTGRES_HOSTNAME=postgres
POSTGRES_PORT=5432
POSTGRES_DB=memchentic

# ------------------------------------------------------------------------------
# embeddings (MiniLM ONNX is hardcoded in the API; no model path / dim env vars)
# ------------------------------------------------------------------------------
# Cosine similarity at/above this refuses a near-duplicate remember (unless force).
NEAR_DUP_THRESHOLD=0.92
# Reciprocal rank fusion constant for hybrid find.
RRF_K=60

# ------------------------------------------------------------------------------
# http
# ------------------------------------------------------------------------------
# Browser origins allowed to call the API (comma-separated). Keep tight to BASE_URL.
CORS_ORIGINS=http://your-host:18080
LOG_LEVEL=INFO
# Session cookie lifetimes (UI login).
SESSION_REMEMBER_DAYS=30
SESSION_BROWSER_HOURS=12
# Empty = Secure when BASE_URL is https://; set true/false to force.
SESSION_COOKIE_SECURE=
