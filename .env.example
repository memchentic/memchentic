# memchentic — copy to .env for local Compose

MEMCHENTIC_BASE_URL=http://localhost:8080

# google | github | okta | authentik | keycloak | auth0 | entra | gitlab | generic | internal
OAUTH_PROVIDER=internal

OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_ISSUER=
OAUTH_AUDIENCE=
OAUTH_JWKS_URI=
OAUTH_SCOPES=openid,profile,email

# Optional dual-accept API key (single shared key for early dev)
# MEMCHENTIC_API_KEY=

# Database — TBD after DB decision
# DATABASE_URL=
