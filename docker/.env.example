# memchentic — copy to .env for local Compose
# Run from this directory: `cd docker && docker compose up -d --build`

# Merge order: prod base, then local bind mounts.
# For a prod-shaped bring-up (no source mounts), use:
#   COMPOSE_FILE=docker-compose.yaml
COMPOSE_FILE=docker-compose.yaml:local.yaml

# Host port for the single app container (API + MCP + React SPA)
MEMCHENTIC_API_PORT=18080

MEMCHENTIC_BASE_URL=http://your-host:18080

# google | github | okta | authentik | keycloak | auth0 | entra | gitlab | generic | internal
OAUTH_PROVIDER=internal

OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_ISSUER=
OAUTH_AUDIENCE=
OAUTH_JWKS_URI=
OAUTH_SCOPES=openid,profile,email

# Break-glass admin for React UI / ops (bootstrap).
# Email is the stable admin identity (same as ordinary users); USER is an alias.
MEMCHENTIC_ADMIN_USER=admin
MEMCHENTIC_ADMIN_EMAIL=admin@nodadyoushutup.com
MEMCHENTIC_ADMIN_PASSWORD=change-me
# Same principal as admin, for MCP/API without the UI login
MEMCHENTIC_ADMIN_API_KEY=change-me-admin-api-key

# Per-user API keys live in the DB (issued in UI).

# Postgres (required) — include DB that has pgvector available
DATABASE_URL=postgresql+asyncpg://memchentic:memchentic@postgres:5432/memchentic

# Embeddings — optional. Image bakes MiniLM at this path; omit to use the
# Dockerfile default. Point elsewhere to try another local ONNX directory.
EMBEDDING_MODEL_PATH=/opt/memchentic/models/all-MiniLM-L6-v2

# UI session cookie signing (same-origin SPA; keep CORS tight to the API URL)
CORS_ORIGINS=http://your-host:18080
LOG_LEVEL=INFO
