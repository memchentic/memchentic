# Local development overlay — copy to local.yaml (gitignored).
# Merged via COMPOSE_FILE=docker-compose.yaml:local.yaml in docker/.env.
#
# Volume mounts (+ uvicorn --reload so bind-mounted Python picks up edits).
# No extra services — GUI is static assets served by application.
#
# ../models overlays the image-baked MiniLM. Run scripts/fetch_minilm_onnx.sh
# once on the host so that mount is not empty (otherwise hash fallback).

services:
  application:
    command:
      [
        "uvicorn",
        "memchentic.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8080",
        "--reload",
        "--reload-dir",
        "/opt/memchentic/src",
      ]
    volumes:
      - ../api:/opt/memchentic
      - ../models:/opt/memchentic/models
      - ../gui/dist:/opt/memchentic/gui/dist:ro
