# memchentic — copy to .env, set every value marked REQUIRED, then: docker compose up -d
# Pulls APPLICATION_IMAGE from Zot (registry.memchentic.ai; GHCR remains the mirror). Do not commit .env.
# ------------------------------------------------------------------------------
# compose
# ------------------------------------------------------------------------------
# Production shape: pull the published image. For local development with
# docker/local.yaml (image build, dev dependencies, bind mounts) use instead:
#   COMPOSE_FILE=docker-compose.yaml:local.yaml
# To run migrations in a one-shot service instead of on application boot:
#   COMPOSE_FILE=docker-compose.yaml:migrate.yaml
COMPOSE_FILE=docker-compose.yaml
# `latest` suits a first try. For production pin a released tag. List them with:
#   curl -fsS https://registry.memchentic.ai/v2/memchentic/memchentic/tags/list
APPLICATION_IMAGE=registry.memchentic.ai/memchentic/memchentic:latest

# ------------------------------------------------------------------------------
# application
# ------------------------------------------------------------------------------
# Host address and port of the one HTTP listener (GUI at /, REST at /api, MCP at /mcp).
# 127.0.0.1 = reachable from this host only; put a TLS reverse proxy in front.
# Use 0.0.0.0 only on a trusted network or when the proxy runs on another host.
BIND_ADDRESS=127.0.0.1
GUI_PORT=18080
# Memory ceiling of the application container (ONNX inference runs in-process).
APPLICATION_MEMORY_LIMIT=2g
# REQUIRED: the public origin that users and MCP clients reach (scheme and host, no path).
BASE_URL=https://memchentic.example.com

# ------------------------------------------------------------------------------
# oauth
# ------------------------------------------------------------------------------
# google | github | okta | authentik | keycloak | auth0 | entra | gitlab | generic | internal
OAUTH_PROVIDER=internal
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_ISSUER=
OAUTH_AUDIENCE=
OAUTH_JWKS_URI=
# Comma-separated. Blank = the provider preset's default scopes.
OAUTH_SCOPES=
# Private-use redirect schemes native MCP clients may register (comma-separated).
OAUTH_NATIVE_REDIRECT_SCHEMES=cursor
# When OAUTH_PROVIDER is not internal, register this redirect on the IdP:
# {BASE_URL}/api/auth/oauth/callback
# (same client id drives MCP harness Authorize and GUI Continue-with)

# ------------------------------------------------------------------------------
# admin
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_DISPLAY_NAME=Admin
# REQUIRED before the first start (the application refuses to boot otherwise):
# 16+ characters each, and the text "change-me" must not appear in them.
ADMIN_PASSWORD=
ADMIN_API_KEY=
# REQUIRED: 32+ chars (e.g. `openssl rand -base64 48`). Encrypts signing keys stored in
# Postgres; losing or changing it invalidates them.
ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# database
# ------------------------------------------------------------------------------
POSTGRES_USER=memchentic
# REQUIRED before the first start. Owner password (Alembic / role bootstrap).
# 16+ chars, not "memchentic". Generate with: openssl rand -hex 24
# Postgres applies it only when the data volume is first created. To change it
# later, run ALTER ROLE in the postgres container first, then update this value.
POSTGRES_PASSWORD=
# Runtime role (NOSUPERUSER, RLS enforced). Created by migration 011; its
# password is re-applied on every start, so POSTGRES_APP_PASSWORD can be rotated.
# POSTGRES_APP_PASSWORD is REQUIRED: 16+ chars. Generate with: openssl rand -hex 24
POSTGRES_APP_USER=memchentic_app
POSTGRES_APP_PASSWORD=
# Apply schema migrations when the application starts. With true (default) the
# application container holds POSTGRES_PASSWORD (owner role) for its lifetime.
# Set false only with the migrate.yaml overlay (or the Helm init container);
# the application container then starts without POSTGRES_PASSWORD.
RUN_MIGRATIONS_ON_BOOT=true
POSTGRES_HOSTNAME=postgres
POSTGRES_PORT=5432
POSTGRES_DB=memchentic
# disable | prefer | require | verify-ca | verify-full. The bundled Compose
# postgres has no TLS, so `prefer` falls back to plaintext on the private bridge
# network. Use verify-full (+ POSTGRES_SSLROOTCERT) for any remote database.
POSTGRES_SSLMODE=prefer
POSTGRES_SSLROOTCERT=

# ------------------------------------------------------------------------------
# embeddings (MiniLM ONNX is hardcoded in the API; no model path / dim env vars)
# ------------------------------------------------------------------------------
NEAR_DUP_THRESHOLD=0.92
RRF_K=60
# Default result counts when MCP/REST omit ``limit`` (hard clamp: RESULT_MAX_LIMIT).
SEARCH_DEFAULT_LIMIT=20
BROWSE_DEFAULT_LIMIT=50
RESULT_MAX_LIMIT=100
# Ranking (see docs: How Relevance Works).
SEARCH_RECENCY_HALF_LIFE_DAYS=30
# Recency is a bounded boost: a just-written memory scores at most
# (1 + SEARCH_RECENCY_WEIGHT) times an old one. Range 0..1; 0 turns recency off.
SEARCH_RECENCY_WEIGHT=0.25
SEARCH_PATH_BOOST=0.15
# Relevance floor: a memory that is not a keyword match is returned only when
# its cosine similarity to the query is at least this value. -1 turns it off.
SEARCH_MIN_SIMILARITY=0.2
NEAR_DUP_CANDIDATES=5
OVERLAP_SCAN_LIMIT=2000
MEMORY_USAGE_SCORE_WEIGHT=0.05
# Sliding TTL: new memories expire after the default unless the caller passes
# ttl_days / permanent; each recall renews a live memory (debounced), never past
# created_at + MEMORY_MAX_TTL_DAYS. 0 disables the default / the ceiling.
MEMORY_DEFAULT_TTL_DAYS=90
MEMORY_TTL_EXTEND_DAYS=90
MEMORY_TTL_TOUCH_DEBOUNCE_HOURS=6
MEMORY_MAX_TTL_DAYS=730

# ------------------------------------------------------------------------------
# http
# ------------------------------------------------------------------------------
# REQUIRED: comma-separated browser origins allowed to call the API. Normally equal to BASE_URL.
CORS_ORIGINS=https://memchentic.example.com
LOG_LEVEL=INFO
SESSION_REMEMBER_DAYS=30
SESSION_BROWSER_HOURS=12
# Leave unset (or blank) to derive from BASE_URL scheme; set true/false to force.
# SESSION_COOKIE_SECURE=
# Reverse proxy in front of the application: comma-separated addresses or
# CIDR ranges of the proxy that may set X-Forwarded-For / X-Forwarded-Proto.
# uvicorn reads this variable itself. Leave unset when clients connect to
# the published port directly. Do not use "*" unless only the proxy can
# reach the published port: any client could then forge its address.
# FORWARDED_ALLOW_IPS=172.16.0.0/12
# Public self-registration (internal OAuth). With an external OAUTH_PROVIDER it
# gates first-time sign-in instead. A person in an IdP group that an auth group
# is bound to is always admitted. When the Users auth group is bound, nobody
# else is admitted and this value is ignored.
# First-boot value only; afterwards System Settings is the source of truth.
REGISTER_ENABLED=true
