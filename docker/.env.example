# memchentic — copy to .env, then: docker compose up -d
# Pulls APPLICATION_IMAGE from Zot (registry.memchentic.ai; GHCR remains the mirror). No local build. Do not commit .env.

# ------------------------------------------------------------------------------
# compose
# ------------------------------------------------------------------------------
COMPOSE_FILE=docker-compose.yaml
APPLICATION_IMAGE=registry.memchentic.ai/memchentic/memchentic:latest

# ------------------------------------------------------------------------------
# application
# ------------------------------------------------------------------------------
GUI_PORT=18080
API_PORT=18081
MCP_PORT=18082
BASE_URL=https://memchentic.docker.nodadyoushutup.com

# ------------------------------------------------------------------------------
# oauth
# ------------------------------------------------------------------------------
# google | github | okta | authentik | keycloak | auth0 | entra | gitlab | generic | internal
OAUTH_PROVIDER=internal
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_ISSUER=
OAUTH_AUDIENCE=
OAUTH_JWKS_URI=
OAUTH_SCOPES=openid,profile,email
# When OAUTH_PROVIDER is not internal, register this redirect on the IdP:
# {BASE_URL}/api/auth/oauth/callback
# (same client id drives MCP harness Authorize and GUI Continue-with)

# ------------------------------------------------------------------------------
# admin
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_DISPLAY_NAME=Admin
ADMIN_PASSWORD=change-me
ADMIN_API_KEY=change-me-admin-api-key
# 32+ chars (e.g. `openssl rand -base64 48`). Encrypts signing keys stored in
# Postgres; losing or changing it invalidates them.
ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# database
# ------------------------------------------------------------------------------
POSTGRES_USER=memchentic
# Owner password (Alembic / role bootstrap). 16+ chars; not "memchentic".
POSTGRES_PASSWORD=
# Runtime role (NOSUPERUSER, RLS enforced). Created by migration 011.
POSTGRES_APP_USER=memchentic_app
POSTGRES_APP_PASSWORD=
POSTGRES_HOSTNAME=postgres
POSTGRES_PORT=5432
POSTGRES_DB=memchentic
# disable | prefer | require | verify-ca | verify-full. The bundled Compose
# postgres has no TLS, so `prefer` falls back to plaintext on the private bridge
# network. Use verify-full (+ POSTGRES_SSLROOTCERT) for any remote database.
POSTGRES_SSLMODE=prefer
POSTGRES_SSLROOTCERT=

# ------------------------------------------------------------------------------
# embeddings (MiniLM ONNX is hardcoded in the API; no model path / dim env vars)
# ------------------------------------------------------------------------------
NEAR_DUP_THRESHOLD=0.92
RRF_K=60
# Default result counts when MCP/REST omit ``limit`` (hard clamp: RESULT_MAX_LIMIT).
SEARCH_DEFAULT_LIMIT=20
BROWSE_DEFAULT_LIMIT=50
RESULT_MAX_LIMIT=100

# ------------------------------------------------------------------------------
# http
# ------------------------------------------------------------------------------
CORS_ORIGINS=https://memchentic.docker.nodadyoushutup.com
LOG_LEVEL=INFO
SESSION_REMEMBER_DAYS=30
SESSION_BROWSER_HOURS=12
# Leave unset (or blank) to derive from BASE_URL scheme; set true/false to force.
# SESSION_COOKIE_SECURE=
# Public self-registration (internal OAuth). Also toggleable in System Settings.
REGISTER_ENABLED=true
