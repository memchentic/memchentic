# Local development overlay — copy to local.yaml (gitignored).
# Merged via COMPOSE_FILE=docker-compose.yaml:local.yaml in docker/.env.
#
# Volume mounts (+ uvicorn --reload so bind-mounted Python picks up edits).
# No extra services — GUI is static assets served by application.
#
# MiniLM lives under application/api/models/ (baked in the image). When this
# overlay mounts the API tree, run scripts/fetch_minilm_onnx.sh once on the
# host so that directory is not empty (otherwise hash fallback).

services:
  application:
    command:
      [
        "uvicorn",
        "memchentic.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8080",
        "--reload",
        "--reload-dir",
        "/opt/memchentic/src",
      ]
    volumes:
      - ../application/api:/opt/memchentic
      # Overlay MCP onto the API src tree (image also bakes this path).
      - ../application/mcp/src/memchentic/mcp:/opt/memchentic/src/memchentic/mcp
      - ../application/gui/dist:/opt/memchentic/gui/dist:ro
