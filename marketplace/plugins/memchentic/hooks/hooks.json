{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "additionalContextLimit": 4000,
            "timeout": 10
          }
        ]
      }
    ],
    "sessionStart": [
      {
        "type": "command",
        "bash": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
        "timeoutSec": 10
      }
    ]
  }
}
